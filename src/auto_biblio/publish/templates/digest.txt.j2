{%- macro line(item) %}
- {{ item.title }}{% if item.revenant %} [revient au goût du jour]{% endif %}{% if item.unverified %} [non vérifié]{% endif %}
  {{ item.url }}
  {{ item.sources }}{% if item.item_type %} · {{ item.item_type }}{% endif %}
{%- if item.reason %}
  {{ item.reason }}
{%- endif %}
{%- if item.verdict %}
  Analyse : {{ item.verdict }}
{%- endif %}
{%- if item.note_url %}
  Fiche : {{ item.note_url }}
{%- endif %}
{%- endmacro -%}
Veille IA — {{ view.week }} ({{ view.count }} contenus)
{%- if view.online_url %}
Voir en ligne : {{ view.online_url }}
{%- endif %}
{% for section in view.sections %}
## {{ section.label }}
{% for item in section.items %}{{ line(item) }}
{% endfor %}{% endfor %}
{%- if view.discoveries %}
## Découvertes (hors de tes thèmes)
{% for item in view.discoveries %}{{ line(item) }}
{% endfor %}{% endif %}
{%- if not view.kb_changes.is_empty %}
## Évolutions de la base
{% for change in view.kb_changes.notes %}
- {{ change.title }} : {{ change.change }}
{%- endfor %}
{%- if view.kb_changes.theme %}
- Page thème {{ view.kb_changes.theme }} réécrite
{%- endif %}
{%- for removed in view.kb_changes.links_removed %}
- Lien retiré : {{ removed }}
{%- endfor %}

{% endif -%}
--
Scoring : {{ view.scoring_version }}{% if view.auc is not none %} (AUC {{ "%.2f"|format(view.auc) }}){% endif %} · LLM : {{ view.tokens }} tokens, {{ "%.3f"|format(view.cost_usd) }} $
{%- for source in view.health.failing_sources %}
! {{ source.source }} en échec depuis {{ source.consecutive_failures }} exécution(s)
{%- endfor %}
{%- for degradation in view.degradations %}
! {{ degradation }}
{%- endfor %}
