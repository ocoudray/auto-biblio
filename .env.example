# Copy to `.env` and adjust. Every setting is prefixed with AUTO_BIBLIO_.
AUTO_BIBLIO_LOG_LEVEL=INFO
# Root of the data repository (defaults to the current directory).
AUTO_BIBLIO_DATA_DIR=.
# GitHub token: raises the GitHub API rate limit (optional).
# AUTO_BIBLIO_GITHUB_TOKEN=ghp_...
AUTO_BIBLIO_HTTP_TIMEOUT_S=30
